# ==============================================================================
# FRONTEND CONFIGURATION (Set in Netlify Site Settings -> Environment Variables)
# NOTE: Variables starting with VITE_ are bundled into the client application!
# Do NOT put database passwords, admin secret codes, or service role keys here.
# ==============================================================================
# Production Backend API (Leave empty in local dev to use Vite proxy /api)
# In production, set to your deployed backend URL, e.g.: https://pazzle-backend.onrender.com
VITE_API_URL=

# Production Backend WebSocket (Leave empty in local dev to use localhost:3001)
# In production, set to your deployed backend WebSocket URL, e.g.: wss://pazzle-backend.onrender.com/ws
VITE_WS_URL=

# Supabase Public Client Credentials (Safe with Row Level Security)
VITE_SUPABASE_URL=https://jammauesxmzpuyatgssv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DFk-DB9_592RknpOlv5bnQ_ghFbEZGV

# ==============================================================================
# BACKEND SERVER CONFIGURATION (Set on backend host: Render, Railway, or Server)
# These are PRIVATE SERVER SECRETS and MUST NOT be exposed in Netlify or frontend!
# ==============================================================================
PORT=3001
NODE_ENV=production
ADMIN_INITIAL_CODE=admin@1977
EMERGENCY_REJOIN_CODE=0000
GEMINI_API_KEY=

# Allowed CORS origins for Express (comma-separated)
CORS_ORIGINS=https://pazzletime.netlify.app,http://localhost:5173

# Supabase Backend Secrets (if calling Supabase with elevated privileges from server)
SUPABASE_URL=https://jammauesxmzpuyatgssv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_DFk-DB9_592RknpOlv5bnQ_ghFbEZGV
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://jammauesxmzpuyatgssv.supabase.co/auth/v1/.well-known/jwks.json
